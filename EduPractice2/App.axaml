<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:EduPractice2.Views"
             xmlns:vm="using:EduPractice2.ViewModels"
             x:Class="EduPractice2.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <DataTemplate DataType="vm:LoginViewModel">
            <views:LoginView />
        </DataTemplate>
        
        <DataTemplate DataType="vm:RegisterViewModel">
            <views:RegisterView />
        </DataTemplate>
        
        <DataTemplate DataType="vm:DirectorWindowViewModel">
            <views:DirectorView />
        </DataTemplate>
        
        <DataTemplate DataType="vm:ManagerWindowViewModel">
            <views:ManagerView />
        </DataTemplate>
        
        <DataTemplate DataType="vm:DesignerWindowViewModel">
            <views:DesignerView />
        </DataTemplate>
        
        <DataTemplate DataType="vm:MasterWindowViewModel">
            <views:MasterView />
        </DataTemplate>
        
        <DataTemplate DataType="vm:CustomerWindowViewModel">
            <views:CustomerView />
        </DataTemplate>
    </Application.DataTemplates>
    
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>